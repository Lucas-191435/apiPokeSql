# Arquivo de configuração para produção na VPS
# Copie este arquivo para .env e ajuste os valores

# Application Settings
PORT=3333
SECRET_KEY=SEU_SECRET_KEY_SUPER_SECRETO_AQUI
APP_URL=https://seu-dominio.com
ENVIRONMENT=production

# Database Configuration
DB_ROOT_PASSWORD=sua_senha_root_mysql_super_secreta
DB_NAME=pokesql
DB_USER=pokesql_user
DB_PASSWORD=sua_senha_db_super_secreta
DATABASE_URL=mysql://pokesql_user:sua_senha_db_super_secreta@db:3306/pokesql?schema=public&sslmode=prefer

# Web URL
WEB_URL=https://seu-frontend.com

