// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AddressType {
  RESIDENTIAL
  COMMERCIAL
  OTHER
}

enum CardStatus {
  CREATED
  UNBOUND
  NORMAL
  CANCELED
  BLOCKED
}

enum AuthorizationCategory {
  AUTHORIZATION
  DECLINED
  CONFIRMATION
  INSTALLMENT
  CANCELLATION
}

enum CardType {
  PLASTIC
  VIRTUAL
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWER
}

enum Gender {
  MALE
  FEMALE
  NOTPROVIDED
}

enum Role {
  ADMIN
  CLIENT
}

enum Region {
  KANTO
  JOHTO
  HOENN
  SINNOH
  UNOVA
}

enum ItemCategory {
  pokeballs
  healing
  pp_recovery
  battle_items
  held_items
  evolution
  berries_food
  machines
  collectibles
  key_items
  mail
  crafting
  special_mechanics
  fossils_and_mining
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?
  role             Role      @default(CLIENT)
  name             String
  avatar           String?
  birthday         DateTime?
  oauthId          String?   @unique
  oauthProvider    String?
  oauthProfileUrl  String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users") // Nome da tabela no banco de dados
}

model Pokemon {
  id        String   @id @default(uuid())
  pokeId    Int   @unique
  name      String   
  img1      String?
  img2      String?
  img3      String?
  types     String?
  abilities String?
  height    Float @default(0)
  weight    Float @default(0)
  region    Region   @default(KANTO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Pokemon") // Nome da tabela no banco de dados
}

model Item {
  id               String    @id @default(uuid())
  pokeItemId       Int     @unique
  pokeCategoryId   Int?
  pokeItemPocketId Int?
  name             String
  sprite           String?
  category         ItemCategory?
  description      String?
  effect           String?
  isConsumable     Boolean @default(false)
  isHeldItem       Boolean @default(false)
  isBattleUse      Boolean @default(false)
  isDiscardable    Boolean @default(false)
  isPokemonUse     Boolean @default(false)
  price            Int?
  regions           String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("items") // Nome da tabela no banco de dados
}
